{
  "name": "beatsync-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "samples": "tsx scripts/make-samples.ts samples",
    "fx-sheet": "tsx scripts/effects-sheet.ts effects-sheet.jpg",
    "app:assemble": "node scripts/app-assemble.mjs && node scripts/check-ffmpeg.mjs",
    "app:dev": "electron .",
    "app:dist": "next build && npm run app:assemble && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "essentia.js": "^0.1.3",
    "idb": "^8.0.4",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wavesurfer.js": "^8.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "electron@45.3.1": true
  },
  "main": "electron/main.cjs",
  "productName": "BeatSync Studio",
  "description": "Automatic beat-synced music video editor",
  "author": "kccosystema",
  "build": {
    "appId": "studio.beatsync.app",
    "productName": "BeatSync Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "app-build/bin",
        "to": "bin"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build-resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "BeatSync Studio",
      "artifactName": "BeatSync-Studio-${version}-arm64.${ext}"
    },
    "afterPack": "build-resources/after-pack.cjs"
  }
}
